{
  "name": "artisan-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run pricing:generate && npm run pricing:normalize",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "portal:generate-access": "node scripts/generate-portal-workbook-access.mjs",
    "portal:generate-dashboard-v1": "node scripts/generate-portal-dashboard-v1.mjs",
    "portal:generate-dashboard-v1:launch": "node scripts/generate-portal-dashboard-v1.mjs --ignore-empty-summary-rows --allow-duplicate-acct-id --allow-invalid-user-account-links",
    "portal:generate-dashboard-v1:launch-safe": "node scripts/generate-portal-dashboard-v1.mjs --ignore-empty-summary-rows --allow-duplicate-acct-id --allow-invalid-user-account-links",
    "pricing:generate": "node scripts/generate-price-list-data.mjs",
    "pricing:normalize": "node scripts/generate-normalized-pricing.mjs",
    "pricing:inspect-dvi": "node scripts/pricing-inspect-dvi.mjs",
    "pricing:generate-dvi": "node scripts/generate-price-list-data-dvi.mjs",
    "pricing:validate-ar": "node scripts/generate-ar-price-guide-validation.mjs",
    "launch:verify": "node scripts/verify-launch-readiness.mjs",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=12288' tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1046.0",
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@studio-freight/lenis": "^1.0.42",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.39.0",
    "gsap": "^3.15.0",
    "jose": "^5.9.6",
    "lenis": "^1.3.23",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "next": "^16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-wrap-balancer": "^1.1.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
