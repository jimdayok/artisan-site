    <div class="order-flow-minimized-icon" id="minimized-icon-global"
         role="button" tabindex="0" aria-label="Return to customizer">
      <span class="minimized-icon-text">Back to Customizer</span>
    </div>

    
    <style>
      /* ========================================
         Order Flow Minimized Button - Vertical Right-Edge
         ======================================== */

      .order-flow-minimized-icon {
        /* Hidden by default - shown via JS */
        display: none;

        /* Positioning - flush to right edge, vertically centered */
        position: fixed;
        right: 0;
        top: 50%;
        transform: translateY(-50%);
        z-index: 3499;

        /* Dimensions */
        width: 48px;
        height: auto;
        max-height: 80vh; /* Safety for very short screens */
        padding: 24px 12px;

        /* Glassmorphism styling */
        background: linear-gradient(135deg, rgba(234, 50, 36, 0.95) 0%, rgba(196, 18, 48, 0.95) 100%);
        border: 3px solid rgba(255, 255, 255, 0.8);
        border-right: none; /* Flush to edge */
        border-radius: 16px 0 0 16px; /* Rounded left corners only */
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
        box-shadow: -4px 0 32px rgba(234, 50, 36, 0.4),
                    0 2px 8px rgba(0, 0, 0, 0.2),
                    inset 0 1px 0 rgba(255, 255, 255, 0.2);

        /* Cursor & transitions */
        cursor: pointer;
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1),
                    box-shadow 0.3s ease;
      }

      .minimized-icon-text {
        /* Vertical text - reads bottom to top */
        writing-mode: vertical-rl;
        text-orientation: mixed;
        transform: rotate(180deg);

        /* Typography */
        color: white;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
        white-space: nowrap;
      }

      /* Hover: slide out slightly from edge */
      .order-flow-minimized-icon:hover {
        transform: translateY(-50%) translateX(-8px);
        box-shadow: -8px 0 48px rgba(234, 50, 36, 0.6),
                    0 4px 16px rgba(0, 0, 0, 0.3),
                    inset 0 1px 0 rgba(255, 255, 255, 0.3);
      }

      /* Active/pressed state */
      .order-flow-minimized-icon:active {
        transform: translateY(-50%) translateX(-4px);
      }

      /* Focus state for accessibility */
      .order-flow-minimized-icon:focus-visible {
        outline: 3px solid rgba(255, 255, 255, 0.9);
        outline-offset: 2px;
      }

      /* ========================================
         Hide on order flow page
         ======================================== */
      body.template-page.page-order-flow .order-flow-minimized-icon,
      body.template-page.page-order-flow #minimized-icon-global {
        display: none !important;
        visibility: hidden !important;
        opacity: 0 !important;
        pointer-events: none !important;
      }

      /* ========================================
         Tablet Styles (768px and below)
         ======================================== */
      @media (max-width: 768px) {
        .order-flow-minimized-icon {
          width: 36px;
          padding: 16px 8px;
          border-radius: 10px 0 0 10px;
        }

        .minimized-icon-text {
          font-size: 11px;
        }

        /* Smaller slide-out distance on mobile */
        .order-flow-minimized-icon:hover {
          transform: translateY(-50%) translateX(-4px);
        }
      }

      /* ========================================
         Phone Styles (480px and below)
         ======================================== */
      @media (max-width: 480px) {
        .order-flow-minimized-icon {
          width: 32px;
          padding: 12px 6px;
        }

        .minimized-icon-text {
          font-size: 10px;
        }
      }
    </style>

    <script>
      // Global floating button click handler
      document.addEventListener('DOMContentLoaded', function() {
        const globalIcon = document.getElementById('minimized-icon-global');
        if (!globalIcon) return;

        // Preload order flow page on hover for instant transition
        globalIcon.addEventListener('mouseenter', function() {
          const existingPrefetch = document.querySelector('link[rel="prefetch"][href="/pages/order-flow"]');
          if (!existingPrefetch) {
            const link = document.createElement('link');
            link.rel = 'prefetch';
            link.href = '/pages/order-flow';
            document.head.appendChild(link);
          }
        });

        const clickHandler = () => {
          const currentPage = window.location.pathname;
          if (!currentPage.includes('/pages/order-flow')) {
            // Navigate to order flow page
            window.location.href = '/pages/order-flow';
          }
        };

        globalIcon.addEventListener('click', clickHandler);
        globalIcon.addEventListener('keypress', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            clickHandler();
          }
        });

        // Function to check and show button if needed with GSAP animation
        function checkAndShowButton() {
          try {
            const isMinimized = localStorage.getItem('orderFlowMinimized') === 'true';
            const isOrderFlowPage = window.location.pathname.includes('/pages/order-flow');

            // Show button if minimized AND not on order flow page
            if (isMinimized && !isOrderFlowPage) {
              // Check if GSAP is available
              if (typeof gsap !== 'undefined') {
                // Set initial state (off-screen to the right)
                gsap.set(globalIcon, {
                  display: 'block',
                  x: 100,  // Start 100px off-screen to the right
                  opacity: 0
                });

                // Slide IN from right edge
                gsap.to(globalIcon, {
                  x: 0,
                  opacity: 1,
                  duration: 0.4,
                  ease: 'power2.out',
                  force3D: true,
                  clearProps: 'x,opacity'  // Clear x so CSS hover transform works
                });
              } else {
                // Fallback if GSAP not loaded yet
                globalIcon.style.display = 'block';
              }
            } else {
              globalIcon.style.display = 'none';
            }
          } catch (e) {
            console.warn('[Global Button] Error:', e);
          }
        }

        // Check on initial load
        checkAndShowButton();

        // Also check when page is shown (handles browser back/forward with bfcache)
        window.addEventListener('pageshow', function(event) {
          console.log('[Global Button] pageshow event, persisted:', event.persisted);
          checkAndShowButton();
        });
      });
    </script>
