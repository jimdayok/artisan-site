{
  "name": "artisan-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/run-prebuild.mjs",
    "build": "NODE_OPTIONS='--max-old-space-size=6144' next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "portal:generate-access": "node scripts/generate-portal-workbook-access.mjs",
    "portal:generate-dashboard-v1": "node scripts/generate-portal-dashboard-v1.mjs",
    "portal:generate-dashboard-v1:launch": "node scripts/generate-portal-dashboard-v1.mjs --ignore-empty-summary-rows --allow-duplicate-acct-id --allow-invalid-user-account-links",
    "portal:generate-dashboard-v1:launch-safe": "node scripts/generate-portal-dashboard-v1.mjs --ignore-empty-summary-rows --allow-duplicate-acct-id --allow-invalid-user-account-links",
    "portal:bundle-dashboard-v1": "node scripts/bundle-portal-dashboard-v1.mjs",
    "portal:generate-net-sales-history": "node scripts/generate-portal-net-sales-history.mjs",
    "locator:generate": "node scripts/generate-patient-locator-data.mjs",
    "build:pricing": "node scripts/build-pricing.mjs",
    "pricing:generate": "node scripts/generate-price-list-data.mjs",
    "pricing:normalize": "NODE_OPTIONS='--max-old-space-size=12288' node scripts/generate-normalized-pricing.mjs",
    "pricing:inspect-dvi": "node scripts/pricing-inspect-dvi.mjs",
    "pricing:generate-dvi": "node scripts/generate-price-list-data-dvi.mjs",
    "pricing:registry": "node scripts/generate-price-list-registry.mjs && node scripts/generate-price-list-style-mapping-gaps.mjs",
    "pricing:validate-ar": "node scripts/generate-ar-price-guide-validation.mjs",
    "launch:verify": "node scripts/verify-launch-readiness.mjs",
    "build:whitepaper": "typst compile publications/aln-strategic-white-paper/main.typ publications/aln-strategic-white-paper/output/ALN-Strategic-White-Paper.pdf",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=12288' tsc --noEmit",
    "test:pricing": "node --test tests/pricing-dvi-generation.test.mjs",
    "test:optical": "node --experimental-default-type=module --test tests/optical-calculations.test.ts tests/optical-geometry.test.ts",
    "test:portal": "node --experimental-strip-types --test tests/account-scope.test.ts tests/admin-rep-review.test.ts tests/net-sales-history-packaging.test.ts tests/portal-role-policy.test.ts tests/portal-user-workbook.test.ts tests/value-system-price-list.test.ts",
    "test:analytics": "node --experimental-strip-types --test tests/analytics.test.ts tests/typeform-webhook.test.ts && node --test tests/consent-manager.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1046.0",
    "@c15t/react": "^2.2.0",
    "@next/third-parties": "^16.3.0",
    "@nivo/bar": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@react-three/fiber": "^9.7.0",
    "@studio-freight/lenis": "^1.0.42",
    "@typeform/embed-react": "^5.0.0",
    "@types/three": "^0.185.4",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.9.3",
    "framer-motion": "^12.39.0",
    "gsap": "^3.15.0",
    "jose": "^5.9.6",
    "jszip": "^3.10.1",
    "lenis": "^1.3.23",
    "lucide-react": "^1.14.0",
    "motion": "^12.38.0",
    "next": "^16.2.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-wrap-balancer": "^1.1.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
