# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

public/hero.mp4
public/hero-vertical.mp4
.env*.local

# local confidential source PDFs used for pricing data extraction
/private-source/

# Allow tracking of required lookup spreadsheets used by the pricing generator
!private-source/portal/lookup_docs/Lookup.xlsx
!private-source/portal/lookup_docs/Lookup_Mat.xlsx
!private-source/portal/lookup_docs/Lookup_AR.xlsx
