  /* Custom CSS Added Via Theme Settings */
  /* Ensure the parent container fills the viewport */
.hero-section {
  position: relative;
  width: 100%;
  height: 100vh; /* Full screen height */
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

/* Make the background image fill the container */
.hero-image {
  width: 100%;
  height: 100%;
  object-fit: cover; /* Ensures the image covers the section */
  position: absolute;
  top: 0;
  left: 0;
  z-index: -1; /* Sends image to the background */
}

/* Style for the text overlay */
.hero-text {
  position: absolute;
  text-align: center;
  color: white;
  font-size: clamp(2rem, 5vw, 6rem); /* Adjusts dynamically based on screen size */
  font-weight: bold;
  text-shadow: 2px 2px 10px rgba(0, 0, 0, 0.7); /* Adds readability */
  width: 90%;
  max-width: 1200px;
  padding: 20px;
}

/* Adjust styling for smaller screens */
@media (max-width: 768px) {
  .hero-text {
    font-size: 3rem;
    padding: 10px;
  }
}

