# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

public/hero.mp4
public/hero-vertical.mp4
.env*.local

# Local confidential source files used for data generation.
/private-source/*

# Required server-side portal workbooks must be committed so Vercel's build
# and runtime functions receive them. They remain outside public/.
!/private-source/portal/
/private-source/portal/*
!/private-source/portal/location_data.xlsx
!/private-source/portal/user_data.xlsx
!/private-source/portal/User_Data.xlsx

# Allow tracking of required lookup spreadsheets used by the pricing generator
!/private-source/portal/lookup_docs/
/private-source/portal/lookup_docs/*
!private-source/portal/lookup_docs/Lookup.xlsx
!private-source/portal/lookup_docs/Lookup_Mat.xlsx
!private-source/portal/lookup_docs/Lookup_AR.xlsx

.playwright-cli/
output/playwright/
*.save

# Generated pricing/build artifacts
tmp/pdfs/
private-source/pricing/generated/
private-source/pricing/raw-price-files/
xml_price_data/

# Local duplicate portal exports; keep only the canonical portal_export.json tracked.
/private-site/portal/portal_export *
