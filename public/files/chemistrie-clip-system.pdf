<script>
(function() {
  'use strict';

  // Defer everything until idle so we never block the configurator.
  var run = function() {
    if (!document || !document.addEventListener) return;

    // Queue calls if clarity() isn't defined yet (snippet may load
    // before the Clarity app's async script hydrates).
    var q = [];
    var flush = function() {
      if (typeof window.clarity !== 'function') return;
      while (q.length) {
        try { window.clarity.apply(null, q.shift()); } catch (e) {}
      }
    };
    var call = function() {
      var args = Array.prototype.slice.call(arguments);
      if (typeof window.clarity === 'function') {
        try { window.clarity.apply(null, args); } catch (e) {}
      } else {
        q.push(args);
      }
    };

    // Periodically retry the queue until clarity() is ready (up to 30s).
    var tries = 0;
    var iv = setInterval(function() {
      tries++;
      if (typeof window.clarity === 'function') { flush(); clearInterval(iv); }
      if (tries > 60) clearInterval(iv);
    }, 500);

    // ---- Step transitions: each step gets its own virtual page URL ----
    document.addEventListener('configurator:step', function(e) {
      var d = (e && e.detail) || {};
      if (d.step) {
        // Virtual page URL → Clarity treats each step as a separate
        // page in heatmaps & funnels, even though the real URL never changes.
        call('set', 'page', '/order-flow/step-' + d.step);
        call('event', 'configurator_step_' + d.step);
      }
      if (d.variant)  call('set', 'variant',   d.variant);
      if (d.lensType) call('set', 'lens_type', d.lensType);
      if (d.clipType) call('set', 'clip_type', d.clipType);
    });

    // ---- Step 2 substeps (variant B/C lens sub-flow) ----
    document.addEventListener('configurator:substep', function(e) {
      var d = (e && e.detail) || {};
      if (d.substep && d.stage) {
        call('set', 'page', '/order-flow/step-2/' + d.stage);
        call('event', 'configurator_substep_' + d.stage);
      }
    });

    // ---- Selection events (segmentation tags) ----
    document.addEventListener('configurator:variant_chosen', function(e) {
      var d = (e && e.detail) || {};
      if (d.variant) {
        call('set', 'variant', d.variant);
        call('event', 'variant_chosen_' + d.variant);
      }
    });

    document.addEventListener('configurator:clip_type_chosen', function(e) {
      var d = (e && e.detail) || {};
      if (d.clipType) {
        call('set', 'clip_type', d.clipType);
        call('event', 'clip_chosen_' + d.clipType);
      }
    });

    document.addEventListener('configurator:add_to_cart', function() {
      // Funnel completion event — what we care about most.
      call('event', 'add_to_cart');
      call('upgrade', 'add_to_cart'); // tells Clarity to prioritize this session for replay
    });
  };

  if ('requestIdleCallback' in window) {
    requestIdleCallback(run, { timeout: 3000 });
  } else {
    setTimeout(run, 1500);
  }
})();
</script>
