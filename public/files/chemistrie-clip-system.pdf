</section><div id="shopify-section-sections--19430307627169__header-chemistrie" class="shopify-section shopify-section-group-header-group">

<script src="//chemistrie.com/cdn/shop/t/15/assets/predictive-search.js?v=3965197855289248181771044131" defer="defer"></script>

<header class="chemistrie-header" >
  <div class="chemistrie-header__wrapper">
    <!-- Combined Header Section -->
    <div class="chemistrie-header__content">
      <div class="chemistrie-header__top-row">
        <!-- Logo -->
        <div class="chemistrie-header__logo">
          <a href="/" class="chemistrie-header__logo-link">
            
              <img src="//chemistrie.com/cdn/shop/t/15/assets/chemistrie-logo-284x46px.webp?v=24613791541348308961771043937" 
                   alt="Chemistrie" 
                   class="chemistrie-header__logo-image"
                   width="284" 
                   height="46"
                   loading="eager">
            
          </a>
        </div>

        <!-- Icons Menu -->
        <nav class="chemistrie-header__icons" aria-label="Utility navigation">
          <!-- Search with expandable field and predictive search -->
          <div class="chemistrie-header__search-container">
            <button class="chemistrie-header__icon chemistrie-header__icon--search"
                    aria-label="Search"
                    data-action="search-toggle">
              <img src="//chemistrie.com/cdn/shop/t/15/assets/Icon-Search-light-72px72px.png?v=178504605674475844281771044008"
                   alt="Search"
                   width="26"
                   height="26">
            </button>
            <predictive-search class="chemistrie-header__search-field" data-search-field>
              <form action="/search" method="get" role="search">
                <input type="search"
                       name="q"
                       placeholder="Search our store"
                       class="chemistrie-header__search-input"
                       aria-label="Search"
                       role="combobox"
                       aria-expanded="false"
                       aria-owns="predictive-search-results"
                       aria-controls="predictive-search-results"
                       aria-haspopup="listbox"
                       aria-autocomplete="list"
                       autocomplete="off">
                <input type="hidden" name="options[prefix]" value="last">
                <button type="button" class="chemistrie-header__search-clear" data-search-clear aria-label="Clear search">
                  ×
                </button>
                <button type="submit" class="chemistrie-header__search-submit">
                  <span class="visually-hidden">Submit</span>
                  →
                </button>
              </form>
              <div data-predictive-search-results class="chemistrie-header__predictive-results" style="display: none;"></div>
            </predictive-search>
            <div class="chemistrie-header__search-backdrop" data-search-backdrop></div>
          </div>

          <!-- Promotions/Gift (Hidden for now) -->
          <button class="chemistrie-header__icon chemistrie-header__icon--gift"
                  aria-label="Promotions"
                  data-action="promotions-toggle"
                  style="display: none;">
            <img src="//chemistrie.com/cdn/shop/t/15/assets/Icon-Gift-light-72px72px.png?v=73365693523960638161771044007" 
                 alt="Promotions" 
                 width="26" 
                 height="26">
          </button>

          <!-- Account -->
          <div class="chemistrie-header__account-container">
            <button class="chemistrie-header__icon chemistrie-header__icon--account"
                    aria-label="My account"
                    data-action="account-toggle">
              <img src="//chemistrie.com/cdn/shop/t/15/assets/Icon-User-light-72px-72pxpng.png?v=41838910711629407511771044023" 
                   alt="My account" 
                   width="26" 
                   height="26">
            </button>
            
            <!-- Account Dropdown - New Customer Accounts (Passwordless) -->
            <div class="chemistrie-header__account-dropdown" data-account-dropdown>
              <div class="chemistrie-header__account-dropdown-content">
                
                  <!-- Not logged in - New Customer Accounts (passwordless) -->
                  <div class="chemistrie-header__account-header">
                    <span class="chemistrie-header__account-greeting">Welcome</span>
                    <p class="chemistrie-header__account-subtitle">Sign in to view your orders and manage your account.</p>
                  </div>

                  <div class="chemistrie-header__account-actions">
                    
                      <a href="/account" class="chemistrie-header__sign-in-btn">
                        Sign In
                      </a>
                    

                    <p class="chemistrie-header__account-new-customer">
                      New customer?
                      
                        <a href="https://chemistrie.com/customer_authentication/redirect?locale=en&region_country=US" class="chemistrie-header__create-account-link">
                          Create an account
                        </a>
                      
                    </p>
                  </div>
                
              </div>
            </div>
          </div>

          <!-- Cart -->
          <div class="chemistrie-header__cart-container"><button class="chemistrie-header__icon chemistrie-header__icon--cart"
                    aria-label="Shopping cart"
                    data-action="cart-toggle">
              <span class="chemistrie-header__cart-count"
                    data-cart-count="0"
                    style="display: none;">
                0
              </span>
              <img src="//chemistrie.com/cdn/shop/t/15/assets/Icon-shopping-cart-72px72px.png?v=123955186514839081741771044009"
                   alt="Shopping cart"
                   width="26"
                   height="26">
            </button>

            <!-- Cart Dropdown -->
            <div class="chemistrie-header__cart-dropdown" data-cart-dropdown><div data-section="cart-header-dropdown"><div class="chemistrie-header__cart-dropdown-content">
                  <div class="chemistrie-header__cart-header">
                    <span class="chemistrie-header__cart-title">Shopping Cart</span>
                    <span class="chemistrie-header__cart-item-count">0 items</span>
                  </div>

                  <div class="chemistrie-header__cart-items">
                    
