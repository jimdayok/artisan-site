            <g stroke="none" stroke-width="1" fill="none" fill-rule="evenodd">
                <g id="Group" transform="translate(0.000000, -1.000000)" fill="currentColor">
                    <rect transform="translate(18.324116, 17.824116) rotate(-315.000000) translate(-18.324116, -17.824116) " x="-4.67588386" y="16.3241161" width="46" height="3" rx="1.5"></rect>
                    <rect transform="translate(17.624104, 17.824116) scale(-1, 1) rotate(-315.000000) translate(-17.624104, -17.824116) " x="-5.37589607" y="16.3241161" width="46" height="3" rx="1.5"></rect>
                </g>
            </g>
        </svg>
    </span>
        <!-- <svg xmlns="http://www.w3.org/2000/svg" height="30px" viewBox="0 0 24 24" width="30px" fill="#0082ca"><path d="M0 0h24v24H0V0z" fill="none"/><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z"/></svg></span> -->
    <h2 class="modal__title">Password Help</h2>
    <hr class="modal__divider">
    <p class="modal__content-desc">Did you know that your EssilorPRO login is used across these Essilor Programs?</p>
    <div class="row">
        <div class="col-sm-6">
            <ul class="modal__content-list">
                <li>LenSelect</li>
                <li>Essilor Preferred Rewards</li>
                <li>Essilor Experts</li>
            </ul>
        </div>
        <div class="col-sm-6">
            <ul class="modal__content-list">
                <li>Essilor Marketing Catalog</li>
                <li>MyFrameBoard.com (Frame Dream)</li>
                <li>Essilor iSafety</li>
        </div>
    </div>
    <div class="row modal__section">
        <div class="col-sm-6">
            <h2 class="modal__title">Reset Forgotten Password</h2>
            <hr class="modal__divider">
            <p class="modal__content-desc">You can always reset your password by clicking here <br/>
                <span class="modal__link">
                    <a href="https://portal.essilorpro.com/reset-password">Forgot Password?</a>
                </span>
            </p>
        </div>
        <div class="col-sm-6">
            <h2 class="modal__title">Contact Customer Support</h2>
            <hr class="modal__divider">
            <p class="modal__content-desc">Need help with resetting your password or you didn't receive it? <br/>
                <span class="modal__link">
                    <a href="https://portal.essilorpro.com/contact-us">Contact Support</a>
                </span>
            </p>
        </div>
    </div>
  </div>
</div>

<script>
// Get the modal
var modal = document.getElementById("myModal");

// Get the button that opens the modal
var btn = document.getElementById("myBtn");

// Get the <span> element that closes the modal
var span = document.getElementsByClassName("close")[0];

// When the user clicks the button, open the modal 
btn.onclick = function() {
  modal.style.display = "block";
}

// When the user clicks on <span> (x), close the modal
span.onclick = function() {
  modal.style.display = "none";
}

window.location.href.substr(0, window.location.href.indexOf('#'))

// When the user clicks anywhere outside of the modal, close it
window.onclick = function(event) {
  if (event.target == modal) {
    modal.style.display = "none";
  }
}
</script></div>
</div>
